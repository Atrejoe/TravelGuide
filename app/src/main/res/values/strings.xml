    <string name="nav_intro">Let the guide follow your navigation app live (notification access, below), or share a route with Travel Guide, and the stories follow it instead of guessing the way ahead.</string>
    <string name="nav_google">• Google Maps: plan directions, then Share. Google offers no route data, so the route is recomputed with OpenStreetMap and may differ slightly.</string>
    <string name="nav_komoot">• Komoot: share a tour link. Private tours: export the tour as GPX and share that file.</string>
    <string name="nav_garmin">• Garmin Connect / Explore: export the course as GPX (or FIT) and share or import the file.</string>
    <string name="nav_other">• Any other app (OsmAnd, …): share or import a GPX file.</string>
    <string name="nav_current_route">Current route: %1$s</string>
    <string name="nav_no_route">No route: the guide guesses the way ahead from your movement.</string>
